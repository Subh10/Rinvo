# mock performs no speech synthesis; useful for API/tests.
# Set to chatterbox_turbo only after installing and verifying upstream dependencies.
RINVO_BACKEND=mock
RINVO_MODEL_ID=chatterbox-turbo
RINVO_DEVICE=auto
# Chatterbox-Turbo requires a local reference voice recording for generation.
# Use only audio you own or have permission to use; do not commit the file.
RINVO_AUDIO_PROMPT_PATH=/absolute/path/to/authorized-reference.wav
RINVO_MAX_TEXT_CHARS=5000
RINVO_HOST=127.0.0.1
RINVO_PORT=8000
